---
// Header.astro
// Props opcionales para marcar el ítem activo del nav
interface Props {
  activeNav?: "descripcion" | "apartamentos" | "zonas-comunes";
}

const { activeNav } = Astro.props;

const navLinks = [
  { id: "descripcion",   label: "Descripción",  href: "#description" },
  { id: "apartamentos",  label: "Apartamentos", href: "#apt" },
  { id: "zonas-comunes", label: "Zonas Comunes",href: "#zonasComunes" },
];
---

<header class="bg-[#f2f2f2] w-full sticky top-0 z-50 shadow-sm">
  <nav
    class="flex items-center justify-between max-w-[1280px] mx-auto px-6 py-6 lg:px-8"
    aria-label="Navegación principal"
  >

    <!-- Logo -->
    <a
      href="/"
      class="flex-shrink-0 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#34a6ba]"
      aria-label="Sorrento – ir al inicio"
    >
      <img
        src="/public/svg/Sorrento.svg"
        alt="Sorrento 2026"
        class="h-[50px] lg:h-[60px] w-auto object-contain"
      />
    </a>

    <!-- Menú desktop + CTA -->
    <div
      class="hidden lg:flex items-center gap-8"
      role="menubar"
      aria-label="Links de navegación"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          role="menuitem"
          class:list={[
            // Base siempre presente
            "nav__link",
            "relative font-semibold text-[18px] leading-normal whitespace-nowrap px-4 py-2 rounded transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#34a6ba]",
            // Estado normal vs activo
            activeNav === link.id
              ? "text-[#34a6ba] nav__link--active"
              : "text-[#333333] hover:text-[#34a6ba]",
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- CTA WhatsApp -->
      <a
        href="https://wa.me/573183955242"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-[10px] bg-[#34a6ba] text-[#f2f2f2] font-semibold text-[18px] leading-normal whitespace-nowrap px-6 py-4 rounded-full shadow-[0px_1px_5px_rgba(0,0,0,0.25)] transition-all duration-200 hover:bg-[#2b8fa0] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#34a6ba]"
        aria-label="Contáctanos por WhatsApp"
      >
        <svg
          class="flex-shrink-0 w-6 h-6"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
          width="24"
          height="24"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        <span class="leading-none">Estoy interesado</span>
      </a>
    </div>

    <!-- Botón hamburguesa (solo mobile) -->
    <button
      id="hamburger-btn"
      type="button"
      class="flex lg:hidden flex-col justify-center items-center w-10 h-10 gap-[6px] rounded transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#34a6ba]"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
    >
      <span class="nav__hamburger-bar block w-6 h-[2px] bg-[#333333] rounded-full transition-all duration-300 origin-center" aria-hidden="true"></span>
      <span class="nav__hamburger-bar block w-6 h-[2px] bg-[#333333] rounded-full transition-all duration-300 origin-center" aria-hidden="true"></span>
      <span class="nav__hamburger-bar block w-6 h-[2px] bg-[#333333] rounded-full transition-all duration-300 origin-center" aria-hidden="true"></span>
    </button>

  </nav>
</header>

<!-- =============================================
     Panel menú móvil (overlay)
============================================= -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 top-100 z-40 bg-[#f2f2f2] shadow-lg pt-8 pb-8 -translate-y-full opacity-0 transition-all duration-300 ease-in-out pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label="Menú móvil"
  hidden
>
  <nav
    class="flex flex-col items-center gap-2 max-w-[480px] mx-auto px-6"
    aria-label="Navegación móvil"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "w-full text-center font-semibold text-[18px] leading-normal px-4 py-3 rounded-lg transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#34a6ba]",
          activeNav === link.id
            ? "text-[#34a6ba] bg-[#34a6ba]/10"
            : "text-[#333333] hover:text-[#34a6ba] hover:bg-[#34a6ba]/10",
        ]}
        data-mobile-link
      >
        {link.label}
      </a>
    ))}

    <!-- CTA WhatsApp mobile -->
    <a
      href="https://wa.me/573183955242"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center justify-center gap-[10px] w-full bg-[#34a6ba] text-[#f2f2f2] font-semibold text-[18px] leading-normal px-6 py-4 rounded-full shadow-[0px_1px_5px_rgba(0,0,0,0.25)] transition-all duration-200 hover:bg-[#2b8fa0] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#34a6ba]"
      aria-label="Contáctanos por WhatsApp"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
        width="22"
        height="22"
      >
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
      <span>Estoy interesado</span>
    </a>
  </nav>
</div>

<!-- =============================================
     SCRIPT  — vanilla JS, sin dependencias
============================================= -->
<script>
  const hamburgerBtn = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const mobileMenu   = document.getElementById('mobile-menu')   as HTMLElement;
  const mobileLinks  = mobileMenu?.querySelectorAll('[data-mobile-link]');

  function openMenu(): void {
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    hamburgerBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
    mobileMenu.removeAttribute('hidden');
    mobileMenu.getBoundingClientRect(); // forzar reflow para activar transición
    mobileMenu.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu(): void {
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    hamburgerBtn.setAttribute('aria-label', 'Abrir menú de navegación');
    mobileMenu.classList.remove('is-open');
    document.body.style.overflow = '';
    mobileMenu.addEventListener(
      'transitionend',
      () => { if (!mobileMenu.classList.contains('is-open')) mobileMenu.setAttribute('hidden', ''); },
      { once: true }
    );
  }

  hamburgerBtn?.addEventListener('click', () => {
    hamburgerBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
  });

  mobileLinks?.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && hamburgerBtn?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      hamburgerBtn.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) closeMenu();
  });
</script>