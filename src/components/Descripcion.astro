---
import Carrusel from "./carrusel/Carrusel.astro";

const {id,ref} = Astro.props;
---

<section id={id} class="flex w-full relative justify-center lg:py-16 py-6">
    <div class="flex flex-wrap lg:flex-nowrap w-full lg:w-7xl px-4 gap-y-8 gap-x-4 z-1">

        
        
        <div class="flex flex-col w-full lg:w-1/2 gap-3 lg:gap-4"> 
            <h2 class="w-full text-(--sorrento-azul-oscuro) font-(--font-black) text-3xl lg:text-4xl">¡Tu nuevo hogar</h2>

            <h3 class="w-full text-(--sorrento-naranja) font-(--font-black) text-4xl lg:text-7xl">está listo!</h3>

            <p class="text-(--sorrento-negro) font-(--font-medium) text-sm lg:text-lg">Tu nuevo hogar listo para entrega inmediata en Bogotá.</p>

            <p class="text-(--sorrento-negro) font-(--font-medium) text-sm lg:text-lg">Ubicado en La Fragua, Antonio Nariño, Sorrento ofrece apartamentos de 50 m² a 60 m², con opciones de 2 y 3 alcobas, pensados para quienes buscan comodidad, ubicación estratégica y valorización.</p>

            <p class="text-(--sorrento-negro) font-(--font-medium) text-sm lg:text-lg">Disfruta de completas zonas comunes como gimnasio, coworking, salón múltiple, BBQ, zona infantil y bicicleteros, en un proyecto diseñado para vivir y crecer.</p>

            <p class=" flex gap-1 text-(--sorrento-negro) font-(--font-medium) text-sm lg:text-lg">Con excelente conectividad y cercanía a futuras estaciones del Metro de Bogotá, Sorrento es la oportunidad ideal para vivir o invertir.</p>

            <a
                href="https://wa.me/573183955242"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full justify-center lg:w-fit inline-flex items-center gap-[10px] bg-[#34a6ba] text-[#f2f2f2] font-semibold text-[18px] leading-normal whitespace-nowrap px-6 py-4 rounded-full shadow-[0px_1px_5px_rgba(0,0,0,0.25)] transition-all duration-200 hover:bg-[#2b8fa0] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#34a6ba]"
                aria-label="Contáctanos por WhatsApp"
            >
                <svg
                class="flex-shrink-0 w-6 h-6"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
                width="24"
                height="24"
                >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                </svg>
                <span class="leading-none">Estoy interesado</span>
            </a>

        </div>

        <Carrusel class=" w-full lg:w-1/2" />
        
    </div>
</section>