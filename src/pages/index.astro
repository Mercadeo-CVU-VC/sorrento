---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import "../styles/global.css";
import Descripcion from '../components/Descripcion.astro';
import Apartamentos from '../components/Apartamentos.astro'
import Zc from '../components/Zc.astro';
import Footer from '../components/Footer.astro';
import Headerv2 from '../components/Headerv2.astro';
import Btn from '../components/Btn.astro';
import Respaldo from '../components/Respaldo.astro';

---

<Layout title="sorrento">
	<Headerv2 /> 
	<Banner ref="#content"/>
	
	<main class="flex flex-col gap-4 lg:gap-8 w-full items-center bg-(--sorrento-blanco)">
		<Descripcion id="description" ref="#form"/>
		<Apartamentos id="apt" ref="#form"/>
		<Zc id="zonasComunes"/>
		<Respaldo />
		<Btn />		
	</main>
	<Footer />
	
	
</Layout>
